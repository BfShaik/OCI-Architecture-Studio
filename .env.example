OCI_NOTIFICATIONS_TOPIC_OCID=
OCI_EVENTS_RULE_OCID=
OCI_MONITORING_NAMESPACE=oci_architecture_studio
OPERATIONAL_DIAGNOSTICS_ENABLED=true

OCI_REGION=
OCI_PROFILE=DEFAULT
OPENAI_API_KEY=
VECTOR_DB_URL=
KNOWLEDGE_INDEX_PATH=knowledge/snapshots/oci-rag-index.json
RELEASE_SNAPSHOT_PATH=knowledge/snapshots/oci-release-snapshot.json
APP_ENV=local
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000

# OCI cloud deployment settings.
# Use standard OCI CLI/SDK config locally. In OCI, prefer instance principals
# and Vault-backed secrets rather than hardcoded credentials.
OCI_AUTH_MODE=config_file
OCI_CONFIG_PROFILE=DEFAULT
OCI_ADMIN_EMAIL=
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_FRONTEND_BUCKET=
OCI_SNAPSHOTS_BUCKET=
OCI_VAULT_SECRET_OCID=
OCI_LOG_GROUP_OCID=
OCI_NOTIFICATION_TOPIC_OCID=
OCI_COMPARTMENT_OCID=
OCI_GENAI_ENDPOINT=
OCI_VECTOR_TARGET=
OCI_BACKEND_SHAPE=VM.Standard.E5.Flex

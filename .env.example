RETRIEVAL_PROVIDER=local_json
ADVISORY_ORCHESTRATION_MODE=multi_agent_pilot
ADVISORY_SYNTHESIS_PROVIDER=deterministic
KNOWLEDGE_INDEX_PATH=knowledge/snapshots/oci-rag-index.json

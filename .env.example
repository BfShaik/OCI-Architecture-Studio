OCI_REGION=
OCI_PROFILE=DEFAULT
OPENAI_API_KEY=
VECTOR_DB_URL=
EMBEDDING_PROVIDER=local
EMBEDDING_FALLBACK_ENABLED=true
RETRIEVAL_PROVIDER=local_json
RETRIEVAL_DEBUG_ENABLED=false
ADVISORY_ORCHESTRATION_MODE=multi_agent_pilot
ADVISORY_SYNTHESIS_PROVIDER=deterministic
SYNTHESIS_DEBUG_ENABLED=false

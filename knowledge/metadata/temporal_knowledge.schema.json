{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oci-architecture-studio.local/schemas/temporal_knowledge.schema.json",
  "title": "OCI Temporal Knowledge Snapshot Metadata",
  "type": "object",
  "required": ["snapshot_id", "knowledge_scope", "generated_at", "snapshot_type"],
  "properties": {
    "snapshot_id": {
      "type": "string"
    },
    "snapshot_type": {
      "type": "string",
      "enum": ["oci_knowledge", "oci_release"]
    },
    "knowledge_scope": {
      "type": "string",
      "enum": ["current", "historical"]
    },
    "generated_at": {
      "type": "string"
    },
    "valid_from": {
      "type": ["string", "null"]
    },
    "valid_to": {
      "type": ["string", "null"]
    },
    "source_snapshot_id": {
      "type": ["string", "null"]
    },
    "source_path": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Operational notes for future release-aware retrieval. Current runtime uses only the active current snapshot."
    }
  }
}

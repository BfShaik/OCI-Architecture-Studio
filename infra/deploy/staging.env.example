# Runtime values for the first OCI-hosted staging slice.
# Copy to a local, untracked staging.env file or translate these values into
# /etc/oci-architecture-studio.env on the backend VM.

APP_ENV=staging
DEPLOYMENT_PROFILE=oci_vm
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=*

KNOWLEDGE_INDEX_PATH=/opt/oci-architecture-studio/knowledge/snapshots/oci-rag-index.json
RELEASE_SNAPSHOT_PATH=/opt/oci-architecture-studio/knowledge/snapshots/oci-release-snapshot.json

OCI_AUTH_MODE=instance_principal
OCI_REGION=us-ashburn-1
OCI_ADMIN_EMAIL=baba.shaik@oracle.com
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_FRONTEND_BUCKET=
OCI_SNAPSHOTS_BUCKET=
OCI_VAULT_CONFIG_SECRET_OCID=
OCI_LOGGING_LOG_GROUP_OCID=
OCI_NOTIFICATIONS_TOPIC_OCID=
OCI_EVENTS_RULE_OCID=
OCI_COMPARTMENT_ID=
OCI_MONITORING_NAMESPACE=oci_architecture_studio
OPERATIONAL_DIAGNOSTICS_ENABLED=true
OCI_CONNECTIVITY_CHECK_ENABLED=false
OCI_GENAI_ENDPOINT=
RETRIEVAL_PROVIDER=oci_object_storage
RETRIEVAL_DEBUG_ENABLED=false
EMBEDDING_PROVIDER=local
EMBEDDING_FALLBACK_ENABLED=true
ADVISORY_SYNTHESIS_PROVIDER=deterministic
SYNTHESIS_DEBUG_ENABLED=false
OCI_VECTOR_TARGET=oci_object_storage
OCI_VECTOR_BUCKET=oci-architecture-studio-staging-knowledge-snapshots
OCI_VECTOR_OBJECT_NAME=oci-rag-index.json
OCI_VECTOR_DB_DSN=
OCI_VECTOR_DB_USER=
OCI_VECTOR_DB_PASSWORD=
OCI_VECTOR_WALLET_LOCATION=
OCI_VECTOR_WALLET_PASSWORD=
OCI_GENAI_COMPARTMENT_ID=
OCI_GENAI_EMBEDDING_MODEL_ID=
OCI_GENAI_EMBEDDING_DIMENSIONS=
OCI_GENAI_CHAT_MODEL_ID=
OCI_GENAI_MAX_TOKENS=1200
OCI_GENAI_TEMPERATURE=0.1
OCI_BACKEND_SHAPE=VM.Standard.E5.Flex
